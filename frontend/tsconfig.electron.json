{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": "electron",
    "outDir": "electron-dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tsbuildinfo",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "electron/**/*.ts"
  ]
}
